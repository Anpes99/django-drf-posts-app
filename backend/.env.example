# Copy to .env and adjust: cp .env.example .env

# Turn on for local development only.
DJANGO_DEBUG=True

# Required: the server will not start without it. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed for CORS and CSRF.
DJANGO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL connection. `docker compose up -d` starts a matching database.
# The e2e tests override DJANGO_DB_NAME with posts_app_e2e.
DJANGO_DB_NAME=posts_app
DJANGO_DB_USER=posts
DJANGO_DB_PASSWORD=posts
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
# Production only: seconds to reuse a connection (keep 0 with runserver).
# DJANGO_DB_CONN_MAX_AGE=60

# Production only: secure cookies (default on) and HTTPS redirect (default off).
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=False

# Email backend (console prints emails to the terminal; use SMTP in production).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
